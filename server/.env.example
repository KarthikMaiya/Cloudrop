# ============================================================
# Cloudrop Express Server — Environment Configuration
# ============================================================
# Copy this file to `.env` and fill in your values.
# The `.env` file is gitignored and must never be committed.
# ============================================================

# -----------------------------------------------------------
# AWS Configuration
# -----------------------------------------------------------
# AWS region where your S3 bucket and DynamoDB table live.
AWS_REGION=ap-south-1

# The existing Cloudrop S3 bucket name (no s3:// prefix).
S3_BUCKET=your-cloudrop-s3-bucket-name

# The existing Cloudrop DynamoDB table name.
DYNAMODB_TABLE=your-cloudrop-dynamodb-table-name

# -----------------------------------------------------------
# AWS Credentials
# -----------------------------------------------------------
# PREFERRED: Use a named AWS profile (set up via `aws configure --profile cloudrop`).
# The SDK credential provider chain picks up profiles automatically.
# AWS_PROFILE=cloudrop
#
# ALTERNATIVE (not recommended for local dev): explicit keys.
# Leave these blank if you are using a profile or instance role.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# -----------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------
PORT=3001

# CORS — set to the exact origin(s) the React frontend uses.
# For local Vite dev: http://localhost:5173
# Comma-separated for multiple origins: http://localhost:5173,https://cloudrop.vercel.app
CORS_ORIGIN=http://localhost:5173

# -----------------------------------------------------------
# Presigned URL Expiry
# -----------------------------------------------------------
# How many seconds the S3 presigned UPLOAD URL remains valid.
# The frontend must upload the file within this window.
UPLOAD_URL_EXPIRY_SECONDS=300

# -----------------------------------------------------------
# Notes
# -----------------------------------------------------------
# 1. AWS credentials are NEVER placed in frontend code or Vite env vars.
# 2. All secrets live only in this server/.env file (gitignored).
# 3. For production deployments (Phase 2), use IAM roles — not static keys.
