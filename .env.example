# Cloudrop Frontend Environment Configuration
# Copy this to `.env` (gitignored) and fill in your values.
# Never commit your real .env file.
#
# ─────────────────────────────────────────────────────────────────────────────
# BACKEND MODE SELECTION
# ─────────────────────────────────────────────────────────────────────────────
# Controls which backend the React frontend connects to.
#
#   serverless  — AWS API Gateway + Lambda (original, production backend)
#   express     — Local Express server (experimental alternative, Phase 1)
#
# Switch between modes here; no React component code needs to change.
VITE_BACKEND_MODE=serverless

# ─────────────────────────────────────────────────────────────────────────────
# SERVERLESS MODE — AWS API Gateway URL
# ─────────────────────────────────────────────────────────────────────────────
# Used when VITE_BACKEND_MODE=serverless (or when VITE_BACKEND_MODE is not set).
# The frontend appends /generate-upload-url, /save-link, /get-link/:id.
#
# Examples:
#   https://your-api-id.execute-api.ap-south-1.amazonaws.com/prod
VITE_API_URL=https://YOUR_API.execute-api.ap-south-1.amazonaws.com/prod

# ─────────────────────────────────────────────────────────────────────────────
# EXPRESS MODE — Local Express server URL
# ─────────────────────────────────────────────────────────────────────────────
# Used when VITE_BACKEND_MODE=express.
# Start the server with: cd server && npm run dev
# Default port is 3001 (set PORT in server/.env to change it).
VITE_EXPRESS_URL=http://localhost:3001

# ─────────────────────────────────────────────────────────────────────────────
# NOTES
# ─────────────────────────────────────────────────────────────────────────────
# - AWS credentials are NEVER placed here. They live only in server/.env.
# - After changing this file, restart the Vite dev server (npm run dev).
# - For Vercel production, set VITE_API_URL and VITE_BACKEND_MODE=serverless
#   in Project Settings → Environment Variables.
